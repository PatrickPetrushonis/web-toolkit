{
  "scaffold_command": "npm create vite@latest {target} -- --template react-ts",
  "always_copy": [
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    ".oxlintrc.json",
    ".nvmrc",
    ".github/workflows/deploy.yml"
  ],
  "hand_authored": ["vite.config.ts"],
