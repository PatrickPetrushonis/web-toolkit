{
  "lint": {
    "superseded_packages": [
      "eslint",
      "typescript-eslint",
      "tslint",
      "standard"
    ],
    "superseded_package_patterns": [
      "^@eslint/",
      "^@typescript-eslint/",
      "^eslint-plugin-",
      "^eslint-config-",
      "^eslint-import-resolver-"
    ],
    "superseded_package_json_fields": [
      "eslintConfig"
    ],
    "review_script_patterns": [
      "eslint",
      "tslint"
    ],
    "superseded_config_files": [
      "eslint.config.js",
      "eslint.config.mjs",
      "eslint.config.cjs",
      "eslint.config.ts",
      "eslint.config.mts",
      "eslint.config.cts",
      ".eslintrc",
      ".eslintrc.js",
      ".eslintrc.cjs",
      ".eslintrc.mjs",
      ".eslintrc.yaml",
      ".eslintrc.yml",
      ".eslintrc.json",
      ".eslintignore",
      "tslint.json"
    ]
  },
  "deploy_mechanism": {
    "superseded_packages": [
      "gh-pages"
    ],
    "superseded_scripts": [
      "predeploy",
      "deploy"
    ],
    "review_script_patterns": [
      "gh-pages"
    ],
    "superseded_config_files": []
  }
}
